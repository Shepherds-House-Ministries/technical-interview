{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "TZ=UTC tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "TZ=UTC NODE_ENV=test vitest run",
    "migrate": "npm run migrate:dev && npm run migrate:test",
    "migrate:dev": "NODE_ENV=development sequelize-cli db:migrate",
    "migrate:test": "NODE_ENV=test sequelize-cli db:migrate",
    "seed": "NODE_ENV=development sequelize-cli db:seed:all"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "moment": "^2.31.0",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "sequelize-cli": "^6.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.0.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "editorconfig": {
      "minimatch": "^11.0.3"
    },
    "js-beautify": {
      "glob": "^14.0.3"
    },
    "sequelize": {
      "uuid": "^11.1.1"
    }
  }
}
